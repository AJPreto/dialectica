{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dialectica.local/schema/logical-blocks.schema.json",
  "title": "Dialectica Logical Form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_text",
    "blocks",
    "relations"
  ],
  "properties": {
    "source_text": {
      "type": "string",
      "description": "Original input text span."
    },
    "language": {
      "type": "string",
      "description": "BCP-47 language tag when known."
    },
    "parse_status": {
      "type": "string",
      "enum": [
        "ok",
        "ambiguous",
        "underspecified",
        "failed"
      ],
      "default": "ok"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "encoding": {
      "$ref": "#/$defs/encoding"
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "claim",
            "goal",
            "constraint",
            "condition",
            "outcome",
            "evidence",
            "definition",
            "question",
            "exception",
            "unknown",
            "ambiguity"
          ]
        },
        "text": {
          "type": "string"
        },
        "canonical_text": {
          "type": "string",
          "description": "Optional normalized paraphrase for indexing."
        },
        "polarity": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "neutral",
            "unknown"
          ],
          "default": "neutral"
        },
        "certainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scope": {
          "type": "string",
          "description": "Optional note on quantifier or modal scope."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_span": {
          "$ref": "#/$defs/source_span"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "implies",
            "depends_on",
            "defines",
            "qualifies",
            "unless",
            "answers"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^b[0-9]+$"
        },
        "certainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a[0-9]+$"
        },
        "description": {
          "type": "string"
        },
        "affected_blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^b[0-9]+$"
          },
          "default": []
        }
      }
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialect",
        "annotated_formulae"
      ],
      "properties": {
        "dialect": {
          "type": "string",
          "enum": [
            "dialectica-ir",
            "cnf",
            "fof",
            "tff",
            "txf",
            "thf",
            "dhf"
          ]
        },
        "logic": {
          "$ref": "#/$defs/logic_descriptor"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "annotated_formulae": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotated_formula"
          }
        },
        "translation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "logic_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "typed": {
          "type": "boolean"
        },
        "higher_order": {
          "type": "boolean"
        },
        "supports_arithmetic": {
          "type": "boolean"
        },
        "supports_conditionals": {
          "type": "boolean"
        },
        "supports_lets": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type_symbol"
          },
          "default": []
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol_declaration"
          },
          "default": []
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol_declaration"
          },
          "default": []
        },
        "constants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol_declaration"
          },
          "default": []
        }
      }
    },
    "type_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "built_in",
            "user_defined"
          ],
          "default": "user_defined"
        },
        "maps_to": {
          "type": "string",
          "description": "Optional source ontology or target theorem-prover type."
        }
      }
    },
    "symbol_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "signature"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "description": "TPTP-style type signature, such as ($i * $i) > $o."
        },
        "arity": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "annotated_formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "formula"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": [
            "cnf",
            "fof",
            "tff",
            "txf",
            "thf",
            "dhf",
            "dialectica-ir"
          ],
          "default": "dialectica-ir"
        },
        "role": {
          "type": "string",
          "enum": [
            "axiom",
            "hypothesis",
            "definition",
            "assumption",
            "lemma",
            "theorem",
            "corollary",
            "conjecture",
            "negated_conjecture",
            "plain",
            "type",
            "interpretation",
            "logic",
            "unknown"
          ]
        },
        "formula": {
          "$ref": "#/$defs/formula_node"
        },
        "linked_blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^b[0-9]+$"
          },
          "default": []
        },
        "source": {
          "$ref": "#/$defs/formula_source"
        },
        "useful_info": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/useful_info_item"
          },
          "default": []
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "formula_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "inference",
            "parser",
            "user"
          ]
        },
        "reference": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "useful_info_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {}
      }
    },
    "formula_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "predicate",
            "function",
            "variable",
            "constant",
            "quantified",
            "unary",
            "binary",
            "equality",
            "inequality",
            "literal",
            "tuple",
            "if_then_else",
            "let",
            "formula_ref"
          ]
        },
        "symbol": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formula_node"
          },
          "default": []
        },
        "operator": {
          "type": "string",
          "enum": [
            "~",
            "|",
            "&",
            "=>",
            "<=",
            "<=>",
            "<~>",
            "=",
            "!="
          ]
        },
        "left": {
          "$ref": "#/$defs/formula_node"
        },
        "right": {
          "$ref": "#/$defs/formula_node"
        },
        "body": {
          "$ref": "#/$defs/formula_node"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typed_variable"
          },
          "default": []
        },
        "quantifier": {
          "type": "string",
          "enum": [
            "!",
            "?",
            "!>",
            "?*",
            "@+",
            "@-"
          ]
        },
        "if": {
          "$ref": "#/$defs/formula_node"
        },
        "then": {
          "$ref": "#/$defs/formula_node"
        },
        "else": {
          "$ref": "#/$defs/formula_node"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/let_binding"
          },
          "default": []
        },
        "type": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "typed_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "let_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "definition"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/formula_node"
        }
      }
    }
  }
}
